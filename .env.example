# FeaturePulse Backend — environment variables
# Copy this file to .env and fill in real values before running.

# ──────────────────────────────────────────────
# Server ports
# ──────────────────────────────────────────────
# Backend (Express/webhook server) defaults to 3001.
# Next.js dashboard defaults to 3000.
# Change PORT here if 3001 is already taken on your machine.
PORT=3001

# ──────────────────────────────────────────────
# GitHub App credentials
# ──────────────────────────────────────────────
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# AI provider
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────
# Redis (Phase 4 — BullMQ job queue)
# ──────────────────────────────────────────────
# Local dev: start Redis with `docker compose up -d redis` (see docker-compose.yml)
# Production (Railway): set this to your Redis add-on URL.
REDIS_URL=redis://localhost:6379
