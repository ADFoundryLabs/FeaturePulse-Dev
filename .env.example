# FeaturePulse Backend — environment variables
# Copy this file to .env and fill in real values before running.

# ──────────────────────────────────────────────
# Server ports
# ──────────────────────────────────────────────
# Backend (Express/webhook server) defaults to 3001.
# Next.js dashboard defaults to 3000.
# Change PORT here if 3001 is already taken on your machine.
PORT=3001

# ──────────────────────────────────────────────
# GitHub App credentials
# ──────────────────────────────────────────────
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# AI provider
# ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ──────────────────────────────────────────────
# Database — Neon Postgres
# ──────────────────────────────────────────────
# Neon provides TWO connection strings per project. They serve different
# consumers and must not be swapped — use the correct one for each service.
#
# ── DATABASE_URL (direct) ────────────────────────────────────────────────────
# Used by: backend (src/db/index.ts, src/worker.ts) running as long-lived
#          processes on Railway.
# Format:
#   postgresql://<user>:<pass>@ep-name-hash.region.aws.neon.tech/<db>?sslmode=require
#
# This is a direct connection to the Neon compute node. pg.Pool reuses TCP
# connections across many queries, so the direct endpoint is correct.
# Do NOT use the pooled endpoint here: PgBouncer transaction mode is
# incompatible with pg.Pool's named prepared statements.
DATABASE_URL=postgresql://<user>:<pass>@ep-name-hash.region.aws.neon.tech/<db>?sslmode=require

# ── DATABASE_URL_POOLED (pooled, PgBouncer-fronted) ──────────────────────────
# Used by: dashboard (dashboard/lib/db.ts) running as Vercel serverless functions.
# Format:
#   postgresql://<user>:<pass>@ep-name-hash-pooler.region.aws.neon.tech/<db>?sslmode=require
#
# The pooled endpoint (-pooler suffix) fronts Neon compute with PgBouncer,
# multiplexing many concurrent Vercel function instances into a small number
# of actual Postgres connections. Without it, concurrent invocations can
# exhaust Neon's direct connection limit (10 on the free tier).
#
# The @neondatabase/serverless Pool class (used in the dashboard) is explicitly
# designed to work with PgBouncer — it avoids named prepared statements that
# PgBouncer transaction mode would drop.
#
# Where to set these in production:
#   DATABASE_URL        → Railway service Variables tab
#   DATABASE_URL_POOLED → Vercel project Settings → Environment Variables
#                         (all environments)
#
# For local dev, both can point to the same direct URL (no need to run PgBouncer
# locally). Copy both lines to dashboard/.env.local as well.
DATABASE_URL_POOLED=postgresql://<user>:<pass>@ep-name-hash-pooler.region.aws.neon.tech/<db>?sslmode=require

# ──────────────────────────────────────────────
# Redis — BullMQ job queue
# ──────────────────────────────────────────────
# Local dev: `docker compose up -d redis` (see docker-compose.yml)
# Production (Render): use Upstash free tier — standard Redis protocol over TLS.
#
# Upstash URL format (from console.upstash.com → your database → Connect tab):
#   rediss://default:<password>@<endpoint>.upstash.io:6380
#
# The rediss:// scheme (double-s) signals TLS — ioredis handles it natively.
# No extra package needed: @upstash/redis is NOT required here (that package
# is for the REST API, which BullMQ does not support; ioredis uses the standard
# Redis protocol and works with Upstash's TLS endpoint directly).
REDIS_URL=redis://localhost:6379
